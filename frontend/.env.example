# API address. Default: http://127.0.0.1:8000 in development, the same origin (relative /api/...) in a production build.
# Leave it UNSET on Vercel's single-project (Services) setup; set it (build-time, redeploy) only for a separate backend host. Not needed behind nginx, which writes /config.js from API_URL at container start.
VITE_API_URL=
# Optional: shows a "Use demo credentials" button on the login page. Put real values only in .env.local (gitignored); never set these on a public deployment.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
