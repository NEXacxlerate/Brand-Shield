# API address (default http://127.0.0.1:8000). On Vercel set it in the frontend project's Environment Variables to the backend project's URL
# (build-time: redeploy the frontend after changing it). Not needed behind nginx, which writes /config.js from API_URL at container start.
VITE_API_URL=
# Optional: shows a "Use demo credentials" button on the login page. Put real values only in .env.local (gitignored); never set these on a public deployment.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
