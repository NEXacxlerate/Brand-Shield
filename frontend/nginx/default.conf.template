# Rendered at container start by the nginx image (envsubst replaces only ${API_URL}; nginx's own $variables are left alone).
server {
  listen 8080;
  server_name _;
  server_tokens off;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # Security headers (set at server level; do not add add_header inside locations, that would drop these).
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=()" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  # The page talks to the API origin (API_URL) and loads Manrope from Google Fonts. Everything else is same-origin.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: ${API_URL}; connect-src 'self' ${API_URL}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

  # Runtime configuration written by /docker-entrypoint.d/40-runtime-config.sh (API address without rebuilding the image).
  location = /config.js {
    alias /tmp/runtime-config/config.js;
    default_type application/javascript;
    expires -1;
  }

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Brand Studio (separate container, built with base /studio/): same origin, so it shares the BrandShield session.
  # The upstream is resolved at request time, so the frontend also starts when no studio container exists (e.g. a plain docker run).
  # `location /studio/` has no add_header of its own, so the server-level security headers above still apply to proxied responses.
  location = /studio {
    return 301 /studio/;
  }
  location /studio/ {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $studio_upstream http://studio:8080;
    proxy_pass $studio_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    # the studio container sends the same security headers for direct access; hide them here so they are not duplicated
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header Content-Security-Policy;
  }

  # Brand Studio calls the API with relative /api URLs on its own origin (this one): forward them to the api container.
  # (BrandShield's own pages keep using API_URL from /config.js.) Logos are up to 2 MB, image generation can take two minutes.
  location /api/ {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://api:8000;
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    client_max_body_size 6m;
    proxy_read_timeout 180s;
  }

  # Hashed build assets can be cached for a year.
  location /assets/ {
    expires 1y;
    try_files $uri =404;
  }

  # Single-page app: unknown paths fall back to index.html (never cached, so a new deploy is picked up).
  location / {
    expires -1;
    try_files $uri /index.html;
  }
}
