# Copy to server/.env and fill in. Names only here - never commit real values.
APP_ENV=
LOG_LEVEL=
DATABASE_URL=
DATA_DIR=
CORS_ORIGINS=
JWT_SECRET=
JWT_ALGORITHM=
ACCESS_TOKEN_MINUTES=
REFRESH_TOKEN_DAYS=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
LOGIN_MAX_FAILURES=
LOGIN_WINDOW_SECONDS=
LOGO_MAX_BYTES=
URL_CHECK_TIMEOUT_SECONDS=
URL_CHECK_MAX_REDIRECTS=
URL_CHECK_MAX_BYTES=
SCAM_LLM_ENABLED=
SCAM_LLM_PROVIDER=
TAVILY_API_KEY=
TAVILY_MONTHLY_BUDGET=
TAVILY_MAX_QUERIES_PER_SCAN=
TAVILY_SEARCH_DEPTH=
TAVILY_MAX_RESULTS=
SEARXNG_BASE_URL=
SEARXNG_ALLOW_PRIVATE_HOSTS=
SEARXNG_MAX_QUERIES_PER_SCAN=
ITUNES_COUNTRY=
ITUNES_CALLS_PER_MINUTE=
ITUNES_CACHE_TTL_SECONDS=
ITUNES_MAX_QUERIES_PER_SCAN=
GOOGLE_PLAY_COUNTRY=
GOOGLE_PLAY_MAX_QUERIES_PER_SCAN=
SOURCE_SLOW_THRESHOLD_MS=
COLLECTOR_TIMEOUT_SECONDS=
REACHABILITY_CHECKS_PER_SCAN=

REDIS_URL=
SCAN_EXECUTOR=
SCAN_QUEUE_NAME=
SCAN_JOB_TIMEOUT_SECONDS=
SCAN_STALE_MINUTES=
SCAN_PREFILTER=
SCAN_LOGO_FETCH=
SCAN_LOGO_MAX_BYTES=
SCAN_LOGO_TIMEOUT_SECONDS=
SCAN_MAX_CANDIDATES=
SCREENSHOTS_ENABLED=
SCHEDULER_ENABLED=
SCAN_INTERVAL_MINUTES=
SCHEDULER_POLL_SECONDS=
GEMINI_API_KEY=
GEMINI_MODEL=
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=
TEXT_EMBEDDINGS_ENABLED=
GEMINI_EMBEDDING_MODEL=
TEXT_PROVIDER_TIMEOUT_SECONDS=
TEXT_PROVIDER_MAX_RETRIES=
SCAN_MAX_LOGO_FETCHES=

# URL reputation (Google Safe Browsing Lookup API v4; non-commercial use only). Leave the key empty to run without it.
GOOGLE_SAFE_BROWSING_API_KEY=
SAFE_BROWSING_TIMEOUT_SECONDS=
SAFE_BROWSING_DAILY_BUDGET=
SAFE_BROWSING_MAX_URLS_PER_SCAN=
SAFE_BROWSING_CACHE_TTL_SECONDS=

# Risk engine severity cutoffs (LOW below MEDIUM_MIN; HIGH and CRITICAL start where the old medium and high bands start)
SEVERITY_MEDIUM_MIN=
SEVERITY_HIGH_MIN=
SEVERITY_CRITICAL_MIN=
CANDIDATE_IMAGE_MAX_BYTES=
IMPORT_MAX_BYTES=
IMPORT_MAX_ROWS=
IMAGE_SIMILARITY_BACKEND=
LOGO_COMPARE_CLIP=

# Speed (remote database): short read cache in seconds (0 = off) and the Postgres connection pool
RESPONSE_CACHE_SECONDS=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_POOL_RECYCLE=
DB_PRE_PING=

# Vercel deployment (docs/DEPLOY_VERCEL.md). Names only.
# STORAGE_BACKEND: local (files under DATA_DIR, default) | database (stored_files table; the default when VERCEL is set)
STORAGE_BACKEND=
# Session-mode / direct Postgres URL (port 5432) used only by alembic and scripts.migrate; DATABASE_URL can then be the transaction pooler (port 6543)
MIGRATION_DATABASE_URL=
# Extra allowed origins as a regular expression (e.g. preview deployments), in addition to CORS_ORIGINS.
# Not needed on Vercel's single-project setup (one origin); CORS_ORIGINS is then only for local development (http://localhost:5173).
CORS_ORIGIN_REGEX=
# Secret for GET /api/cron/scan (Vercel Cron sends it as a Bearer token); unset = the endpoint is off
CRON_SECRET=

# Sign-up (POST /api/auth/register). No email verification; limits are in memory per process.
SIGNUP_ENABLED=
SIGNUP_MAX_PER_IP_PER_HOUR=
SIGNUP_MAX_PER_EMAIL_PER_HOUR=
SCHEDULER_MAX_BRANDS_PER_RUN=

# Brand Studio AI proxy (/api/studio/ai/*). Keys stay on the server. Chat: GROQ_API_KEY, else GEMINI_API_KEY (above). Images: POLLINATIONS_API_KEY (Pollinations).
GROQ_API_KEY=
POLLINATIONS_API_KEY=
STUDIO_GROQ_MODEL=
STUDIO_IMAGE_MODEL=
STUDIO_AI_RATE_PER_MINUTE=
STUDIO_DAILY_TEXT_QUOTA=
STUDIO_DAILY_IMAGE_QUOTA=
STUDIO_AI_TIMEOUT_SECONDS=
STUDIO_IMAGE_TIMEOUT_SECONDS=
STUDIO_AI_MAX_RETRIES=
STUDIO_AI_RETRY_BACKOFF_SECONDS=
STUDIO_MAX_MESSAGES=
STUDIO_MAX_CHARS=
STUDIO_MAX_TOKENS=
STUDIO_MAX_PROMPT_CHARS=

# Public demo account shown on the login page (role analyst). Both unset = no demo button.
DEMO_EMAIL=
DEMO_PASSWORD=

# Second PUBLIC demo account: a GUARDED administrator (cannot use live data, change the AI provider, see other accounts' audit rows or set the webhook).
# Both unset = no admin demo button. The email must differ from ADMIN_EMAIL and DEMO_EMAIL.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
