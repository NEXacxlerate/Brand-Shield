# Copy to .env and edit. Every secret lives here (or in real environment variables), never in code.

# --- core ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# SQLite by default. For Postgres: postgresql+psycopg://user:password@host:5432/scammind  (add psycopg[binary] to requirements)
DATABASE_URL=
DATA_DIR=./data
# The browser origin(s) allowed to call the API (comma separated)
FRONTEND_ORIGIN=http://localhost:5173
# "production" stops the password-reset token being printed to the console
ENV=dev

# --- demo mode: creates the admin, the fictional brand Acme Bank and synthetic history (all labelled sample) ---
DEMO_MODE=true
ADMIN_NAME=Harini
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=ChangeMe!123

# --- tokens ---
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- background jobs / limits ---
SCHEDULER_ENABLED=true
RATE_LIMIT_ENABLED=true
MAX_APK_MB=100
MAX_UPLOAD_MB=50
MAX_LOGO_MB=4

# --- optional AI summaries (any OpenAI-compatible endpoint). Without a key the rule-based text is used. ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- optional reputation lookups (informational; not scored). Enable them in Settings > Integrations. ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_AUTH_KEY=
