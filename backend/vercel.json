{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,scripts/**,data/**,.venv/**,**/__pycache__/**,.pytest_cache/**,.ruff_cache/**}"
    }
  },
  "crons": [
    { "path": "/api/cron/scan", "schedule": "0 6 * * *" }
  ]
}
